# 🔒 敏感資訊（請勿提交至 Git）
TOKEN=你的_Discord_Bot_Token
OPENROUTER_API_KEY=你的_OpenRouter_API_Key
GROQ_API_KEY=你的_Groq_API_Key（setting.json 設 AI_PROVIDER=groq 時才需要）
CWA_API_KEY=你的_中央氣象署_API_Key

# Owner dashboard（預設關閉；CLIENT_SECRET 是 Discord OAuth2 secret，非 Bot Token）
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8080
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
